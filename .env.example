APP_NAME=AdminCare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=30
SESSION_ENCRYPT=false
# Use false only for local HTTP; Render/production sets this to true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

# Local CSRF/CORS topology: React (localhost) -> Laravel (127.0.0.1).
CORS_ALLOWED_ORIGINS=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:8000

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local
DEMO_MODE=true
# Required only to bootstrap/reset an unmarked demo database. Remove after the first seed.
DEMO_DATABASE_ALLOW_RESET=false
